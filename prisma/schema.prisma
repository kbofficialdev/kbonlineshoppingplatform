// Prisma Schema for KB Online Shopping Platform (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                    Int      @id @default(autoincrement())
  productId             String   @unique @map("product_id")
  merchantId            String   @map("merchant_id")
  name                  String
  title                 String
  price                 Float
  currency              String   @default("INR")
  category              String
  tags                  String[]
  hsnCode               String   @map("hsn_code")
  countryOfOrigin       String   @default("India") @map("country_of_origin")
  isGovtVerifiedSeller  Boolean  @default(true) @map("is_govt_verified_seller")
  taxRatePercent        Float    @default(18.0) @map("tax_rate_percent")
  sizes                 String[]
  colors                String[]
  rating                Float    @default(4.8)
  reviews               Int      @default(0)
  stockQuantity         Int      @default(50) @map("stock_quantity")
  manufacturerDetails   String   @map("manufacturer_details")
  collection            String
  fabricCare            String?  @map("fabric_care")
  fitSizing             String?  @map("fit_sizing")
  returnPolicy          String?  @map("return_policy")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  subtitle  String
  itemCount Int      @default(0) @map("item_count")

  @@map("categories")
}

model CartItem {
  id             String   @id @default(cuid())
  sessionId      String   @map("session_id")
  productId      String   @map("product_id")
  name           String
  price          Float
  size           String
  color          String   @default("#111111")
  qty            Int      @default(1)
  taxRatePercent Float    @default(18.0) @map("tax_rate_percent")
  hsnCode        String   @map("hsn_code")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("cart_items")
}

model Order {
  id                    String      @id @default(cuid())
  orderId               String      @unique @map("order_id")
  invoiceNumber         String      @unique @map("invoice_number")
  customerName          String      @map("customer_name")
  customerPhone         String      @map("customer_phone")
  customerEmail         String?     @map("customer_email")
  streetAddress         String      @map("street_address")
  pinCode               String      @map("pin_code")
  city                  String
  state                 String
  b2bGstin              String?     @map("b2b_gstin")
  subtotal              Float
  discountAmount        Float       @default(0) @map("discount_amount")
  shippingFee           Float       @default(0) @map("shipping_fee")
  taxableBase           Float       @map("taxable_base")
  cgst                  Float       @default(0)
  sgst                  Float       @default(0)
  igst                  Float       @default(0)
  totalPaid             Float       @map("total_paid")
  paymentMethod         String      @map("payment_method")
  paymentStatus         String      @default("CAPTURED") @map("payment_status")
  orderStatus           String      @default("CONFIRMED") @map("order_status")
  estimatedDeliveryDays Int         @default(3) @map("estimated_delivery_days")
  createdAt             DateTime    @default(now()) @map("created_at")
  items                 OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  productId   String   @map("product_id")
  hsnCode     String   @map("hsn_code")
  title       String
  qty         Int
  unitPrice   Float    @map("unit_price")
  taxAmount   Float    @map("tax_amount")
  totalAmount Float    @map("total_amount")
  size        String
  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("order_items")
}

model StatutoryTaxInvoice {
  id               String   @id @default(cuid())
  invoiceNumber    String   @unique @map("invoice_number")
  orderId          String   @unique @map("order_id")
  sellerLegalName  String   @map("seller_legal_name")
  sellerGstin      String   @map("seller_gstin")
  sellerAddress    String   @map("seller_address")
  buyerName        String   @map("buyer_name")
  buyerGstin       String?  @map("buyer_gstin")
  totalPaid        Float    @map("total_paid")
  verificationHash String   @map("verification_hash")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("statutory_tax_invoices")
}

model MerchantKYC {
  id                        String    @id @default(cuid())
  merchantId                String    @unique @map("merchant_id")
  legalBusinessName         String    @map("legal_business_name")
  brandTradeName            String    @map("brand_trade_name")
  entityType                String    @map("entity_type")
  gstin                     String    @unique
  incorporationNumber       String    @map("incorporation_number")
  contactEmail              String    @map("contact_email")
  contactPhone              String    @map("contact_phone")
  registeredAddress         String    @map("registered_address")
  qualityCertifications     String[]  @map("quality_certifications")
  verificationStatus        String    @default("PENDING") @map("verification_status")
  verificationSealTimestamp DateTime? @map("verification_seal_timestamp")
  complianceNotes           String?   @map("compliance_notes")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@map("merchant_kyc")
}

model AuditLog {
  id           String   @id @default(cuid())
  logId        String   @unique @map("log_id")
  timestamp    DateTime @default(now())
  actorId      String   @map("actor_id")
  actorRole    String   @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  details      Json
  previousHash String   @map("previous_hash")
  hash         String

  @@map("audit_logs")
}
