// Prisma Schema for KB FASHIONS Online Shopping Platform (PostgreSQL)
// Village Enterprise Edition - Kalwaral, Kamareddy, Telangana (GST Exempted Small Business)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StoreSettings {
  id                    String   @id @default("kb-fashions-main")
  brandName             String   @default("KB") @map("brand_name")
  officialName          String   @default("KB FASHIONS") @map("official_name")
  address               String   @default("3-55/1, Kalwaral(Vil), Sadasivanagar(M), Kamareddy(D), Telangana(TG), 503145.")
  village               String   @default("Kalwaral")
  mandal                String   @default("Sadasivanagar")
  district              String   @default("Kamareddy")
  state                 String   @default("Telangana")
  pinCode               String   @default("503145") @map("pin_code")
  contactEmail          String   @default("kb.official.admin@gmail.com") @map("contact_email")
  contactPhone          String   @default("+91 7989768200") @map("contact_phone")
  gstExempt             Boolean  @default(true) @map("gst_exempt")
  exemptionNotice       String   @default("Small rural artisan & retail occupation enterprise exempted from GST under Section 23 of CGST Act / Telangana SGST Act.") @map("exemption_notice")
  historySince          String   @default("Serving our village & patrons for 20 years with ancestral dedication.") @map("history_since")
  story                 String   @default("KB FASHIONS has been rooted in Kalwaral village for over two decades. Originating as part of our ancestral occupation in fine textiles, we now bring honest quality, durable fabrics, and traditional warmth directly online to customers across India.")
  freeShippingThreshold Float    @default(999) @map("free_shipping_threshold")
  flatShippingFee       Float    @default(70) @map("flat_shipping_fee")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  phone             String          @unique
  passwordHash      String          @map("password_hash")
  role              String          @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  avatar            String?
  villageOrCity     String?         @map("village_or_city")
  mandalOrArea      String?         @map("mandal_or_area")
  district          String?
  state             String?         @default("Telangana")
  pinCode           String?         @map("pin_code")
  preferredLanguage String          @default("en") @map("preferred_language") // "en" or "te"
  smsUpdates        Boolean         @default(true) @map("sms_updates")
  whatsappUpdates   Boolean         @default(true) @map("whatsapp_updates")
  bio               String?
  isActive          Boolean         @default(true) @map("is_active")
  otpCode           String?         @map("otp_code")
  otpExpiresAt      DateTime?       @map("otp_expires_at")
  resetToken        String?         @map("reset_token")
  resetExpiresAt    DateTime?       @map("reset_expires_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  addresses         Address[]
  paymentMethods    PaymentMethod[]

  @@map("users")
}

model Address {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  name          String
  phone         String
  tag           String   @default("Home") // Home, Work, Village, Other
  streetAddress String   @map("street_address")
  villageOrCity String   @map("village_or_city")
  mandalOrArea  String?  @map("mandal_or_area")
  district      String
  state         String   @default("Telangana")
  pinCode       String   @map("pin_code")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model PaymentMethod {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String   @default("UPI") // UPI, CARD, NETBANKING, COD
  label      String
  identifier String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model Product {
  id              String         @id @default(cuid())
  productId       String         @unique @map("product_id")
  name            String
  title           String
  description     String
  price           Float
  compareAtPrice  Float?         @map("compare_at_price")
  category        String
  productType     String         @default("GENERAL") @map("product_type") // SAREE, MEN_UNSTITCHED, WOMEN_WEAR, BLOUSE_PIECE, DHOTI_TOWEL, INNER_ESSENTIAL, GENERAL
  brand           String         @default("KB FASHIONS")
  fabric          String         @default("Pure Cotton")
  isUnstitched    Boolean        @default(false) @map("is_unstitched")
  unitType        String         @default("PIECE") @map("unit_type") // PIECE or METER
  pricePerMeter   Float?         @map("price_per_meter")
  availableMeters Float[]        @default([]) @map("available_meters")
  tags            String[]
  sizes           String[]
  colors          String[]
  stockQuantity   Int            @default(50) @map("stock_quantity")
  rating          Float          @default(4.9)
  reviews         Int            @default(0)
  fabricCare      String?        @map("fabric_care")
  origin          String         @default("Kalwaral, Telangana, India")
  isFeatured      Boolean        @default(false) @map("is_featured")
  sareeDetails    Json?          @map("saree_details")
  unstitchedDetails Json?        @map("unstitched_details")
  essentialDetails Json?         @map("essential_details")
  matchingDetails Json?          @map("matching_details")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  images          ProductImage[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  name      String
  mimeType  String   @default("image/svg+xml") @map("mime_type")
  data      String   @map("image_data") // Stored in PostgreSQL (Base64 data URL or SVG XML)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("product_images")
}

model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  subtitle  String
  itemCount Int      @default(0) @map("item_count")

  @@map("categories")
}

model CartItem {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  userId        String?  @map("user_id")
  productId     String   @map("product_id")
  name          String
  price         Float
  size          String
  color         String   @default("#111111")
  qty           Int      @default(1)
  cutLength     Float?   @map("cut_length")
  configuration Json?    @map("configuration")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("cart_items")
}

model Order {
  id                    String               @id @default(cuid())
  orderId               String               @unique @map("order_id")
  invoiceNumber         String               @unique @map("invoice_number")
  userId                String?              @map("user_id")
  customerName          String               @map("customer_name")
  customerPhone         String               @map("customer_phone")
  customerEmail         String               @map("customer_email")
  streetAddress         String               @map("street_address")
  villageOrCity         String               @map("village_or_city")
  mandalOrArea          String?              @map("mandal_or_area")
  district              String
  state                 String
  pinCode               String               @map("pin_code")
  subtotal              Float
  discountAmount        Float                @default(0) @map("discount_amount")
  shippingFee           Float                @default(0) @map("shipping_fee")
  totalPaid             Float                @map("total_paid")
  paymentMethod         String               @default("COD") @map("payment_method") // COD, UPI, CARD
  paymentStatus         String               @default("PENDING") @map("payment_status") // PENDING, CAPTURED, REFUNDED
  orderStatus           String               @default("ORDER_PLACED") @map("order_status") // ORDER_PLACED, CONFIRMED, DISPATCHED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  courierPartner        String?              @map("courier_partner")
  trackingNumber        String?              @map("tracking_number")
  estimatedDeliveryDays Int                  @default(3) @map("estimated_delivery_days")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  items                 OrderItem[]
  timeline              OrderTimelineEvent[]

  @@map("orders")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String  @map("order_id")
  productId     String  @map("product_id")
  title         String
  qty           Int
  unitPrice     Float   @map("unit_price")
  totalAmount   Float   @map("total_amount")
  size          String
  cutLength     Float?  @map("cut_length")
  configuration Json?   @map("configuration")
  order         Order   @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("order_items")
}

model OrderTimelineEvent {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  stage       String // ORDER_PLACED, CONFIRMED, DISPATCHED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  title       String
  description String
  location    String
  timestamp   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("order_timeline_events")
}

model RefundRequest {
  id          String    @id @default(cuid())
  orderId     String    @map("order_id")
  reason      String
  amount      Float
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  notes       String?
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("refund_requests")
}

model AuditLog {
  id           String   @id @default(cuid())
  actor        String
  role         String
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  metadata     String
  previousHash String   @map("previous_hash")
  currentHash  String   @map("current_hash")
  timestamp    DateTime @default(now())

  @@map("audit_logs")
}

model Banner {
  id        String   @id @default(cuid())
  bannerId  String   @unique @map("banner_id")
  title     String
  subtitle  String?
  badge     String?
  category  String   @default("HERO") // HERO, WELCOME, FEATURE, AI
  mediaId   String   @map("media_id")
  imageUrl  String   @map("image_url")
  linkUrl   String   @default("/search") @map("link_url")
  ctaText   String   @default("Explore Collection") @map("cta_text")
  position  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banners")
}

model SupportTicket {
  id              String          @id @default(cuid())
  ticketNumber    String          @unique @map("ticket_number")
  userId          String?         @map("user_id")
  customerName    String          @map("customer_name")
  customerEmail   String          @map("customer_email")
  customerPhone   String          @map("customer_phone")
  category        String          @default("ORDER_ISSUE") // ORDER_ISSUE, WEAVING_ADVICE, DELIVERY_STATUS, PRODUCT_QUERY, BILLING_PAYMENT, GRIEVANCE_RULE_5_9, OTHER
  priority        String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  orderId         String?         @map("order_id")
  subject         String
  status          String          @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOR_CUSTOMER, REOPENED, RESOLVED, CLOSED
  slaHours        Int             @default(24) @map("sla_hours")
  assignedTo      String?         @map("assigned_to")
  firstResponseAt DateTime?       @map("first_response_at")
  resolvedAt      DateTime?       @map("resolved_at")
  closedAt        DateTime?       @map("closed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  messages        TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id          String        @id @default(cuid())
  ticketId    String        @map("ticket_id")
  senderRole  String        @map("sender_role") // CUSTOMER, ADMIN, SUPPORT_AGENT
  senderName  String        @map("sender_name")
  message     String
  attachments Json?         @default("[]")
  createdAt   DateTime      @default(now()) @map("created_at")
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}


